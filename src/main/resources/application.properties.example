# --- CONFIGURACIÓN DE BASE DE DATOS ---
# Puedes definir estas variables en tu Sistema Operativo o dejar los valores por defecto
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/nombre_tu_bd}
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD:tu_password_aqui}

# --- CONFIGURACIÓN DE JPA / HIBERNATE ---
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# --- SEGURIDAD ---
# Cambia esto por una cadena aleatoria en producción
app.security.jwt-secret=${JWT_SECRET:secret_key_temporal}